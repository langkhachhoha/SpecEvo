# SpecEvo talks to every model through OpenRouter.
# Get a key at https://openrouter.ai/keys and paste it below, then
#   cp .env.example .env
#
# The key is read by both runners; an OpenRouter key (sk-or-...) placed in
# OPENAI_API_KEY is also mirrored into OPENROUTER_API_KEY automatically.
OPENAI_API_KEY=sk-or-v1-...

# Optional: cap total spend across a run (USD). Unset = no cap.
# SPECEVO_MAX_COST_USD=10

# Optional: append a JSONL record of every LLM call to this path.
# SPECEVO_COST_LOG=outputs/cost_log.jsonl
